    {
      "id": "THEMELAB-SIM-003",
      "severity": "medium",
      "owner": "theme-lab-fixture",
      "blocker": false,
      "status": "fixed-in-branch",
      "title": "WebKit page-image replay misclassified routed or policy-blocked images as missing assets",
      "description": "The WebKit post-navigation image pass treated every non-page-origin image absent from its data-URL lookup as a missing asset. That double-counted content-addressed wjfiles.localhost images already fulfilled by the local route and also turned ordinary policy-blocked external page images into WebKit-only asset failures.",
      "fix": "Only URLs explicitly present in the WebKit external-page-asset replay map are replaced/decoded there; content-addressed local assets remain owned by the route handler and other external images remain owned by the network-policy blocked-external accounting. The Sigma-10 nav-side black.png was additionally frozen as a content-addressed fixture static asset.",
      "evidence": "After the fix, all 35 themes plus sigma10-baseline recaptured at WebKit desktop and mobile page.normal with 0 action failures and 0 asset failures; the nav-side black.png bytes are bound as 4f8c6d416f09671777934e57bc67fb52ccc97145dc6f1869e628d9ffd7d8f6e7.png.",
      "classification": "FIXED",
      "actionable": false,
      "decision_authority": "SCP_JP_LOCAL_TARGET_ACCEPTANCE_ONLY",
      "port_conclusion_eligible": false,
      "finding_scope": "SCP_JP_TARGET_ACCEPTANCE"
    },
