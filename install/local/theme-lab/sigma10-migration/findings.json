    {
      "id": "SIGMA10-MOB-001",
      "severity": "medium",
      "owner": "sigma10-staff-source",
      "blocker": false,
      "title": "Sigma-10 JP credit preview notice forces tablet/mobile horizontal document overflow",
      "affected_surface": [
        "page.normal",
        "nav.mobile-top",
        "nav.sidebar",
        "shell.search",
        "shell.footer-license",
        "shell.interwiki"
      ],
      "browser": [
        "chromium",
        "firefox",
        "webkit"
      ],
      "viewport": [
        "tablet",
        "mobile",
        "narrow-mobile"
      ],
      "interaction_state": "settled (unmodified page load)",
      "technical_staff_source_revision": "2bfcb97451695d99e8d056c3ac40ec954e005636",
      "source_file": "sources/jp-localization.css (compiled into sigma10-offline.css, sha256 08b5e63699eae178f35fc1958560d4c794a3dd5078bbf5f6f9e72906ac34f87e)",
      "selector": " .creditRate::before  (with .creditRate > li { display: none })",
      "source_fragment": ".creditRate::before { content: '\\30d7\\30ec\\30d3\\30e5\\30fc\\6642...'; display: list-item; font-weight: bold; margin: 1.5em 0; white-space: pre; }",
      "observed_behavior": "At 768px Chromium expands the document to 806px; at 390px the document scrollWidth is 503 (chromium), 504 (firefox), and 492 (webkit); at 320px Chromium expands to 500px. The single-line ::before content cannot wrap because white-space:pre, so ul.creditRate overflows and expands the document. The controlled Sigma-9 mobile baseline on the identical page and shell remains 390px wide.",
      "expected_behavior": "The credit notice should wrap (or be scoped to preview) so no document-level horizontal overflow occurs at supported tablet/mobile widths.",
      "why_sigma10_not_wikijump": "The overflow appears only when the Sigma-10 replacement CSS is applied; the identical DOM under the runtime Sigma-9 baseline measures 390. Removing ul.creditRate from the same Sigma-10 DOM drops documentWidth 511->390 (isolated probe). The rule and its white-space:pre are Sigma-10 JP localization source.",
      "minimal_recommended_change": "Change the notice to white-space: pre-wrap (or normal), and scope the notice+'.creditRate > li{display:none}' rule to the preview context only if that was the intent.",
      "evidence": {
        "chromium_mobile_screenshot": "migration/sigma10/sigma10-baseline/artifacts/interactive/chromium/mobile/page-normal-settled-mobile-3f110dcfa6cbfa405d1602daddbd91fce8276b4a1e60501e5d8cc5139f48bfa7.png",
        "chromium_mobile_screenshot_sha256": "3f110dcfa6cbfa405d1602daddbd91fce8276b4a1e60501e5d8cc5139f48bfa7",
        "document_width": 503,
        "viewport_width": 390,
        "reviewed_classification": "NEEDS_FIX"
      },
      "theme_impact": {
        "field_themes_tested": 35,
        "field_themes_with_added_mobile_overflow": 30,
        "field_themes_containing_it": 4,
        "baseline_probe_also_adds_overflow": true,
        "note": "Document width equals ul.creditRate reachable_right for every theme that overflows; contained themes clip it and keep documentWidth 390."
      },
      "fix_verification": "In an isolated browser load of the captured Sigma-10 mobile DOM, adding .creditRate::before{white-space:pre-wrap !important} reduced document scrollWidth from 511 to 390.",
      "classification": "CONFIRMED",
      "actionable": true,
      "decision_authority": "SCP_JP_LOCAL_TARGET_ACCEPTANCE_ONLY",
      "port_conclusion_eligible": false,
      "finding_scope": "SCP_JP_TARGET_ACCEPTANCE"
    },
    {
      "id": "THEMELAB-SIM-001",
      "severity": "high",
      "owner": "theme-lab-fixture",
      "blocker": false,
      "status": "fixed-in-branch",
      "title": "Migration shell injection was silently reverted by Svelte hydration",
      "description": "The source-derived #top-bar/#side-bar substitution ran immediately after DOMContentLoaded, but the Svelte shell hydrates ~1.3 s later and re-rendered the stale Theme Lab acceptance navigation over it. Until fixed, every migration nav/shell state measured the retired Sigma-9 acceptance shell rather than the Sigma-10 SCP-JP shell.",
      "evidence": "Captured DOM before the fix contained Theme Lab navigation; after the fix #side-bar contains the Sigma-10 nav-side (初めての方へ) and #top-bar contains the Sigma-10 nav-top ([# SCPデータベース]).",
      "fix": "capture-interactive.mjs injectMigrationShell() now waits for a delegated Svelte handler as a hydration barrier and re-applies the substitution until it survives a 400 ms quiet window, failing hard if it never stabilises.",
      "classification": "FIXED",
      "actionable": false,
      "decision_authority": "SCP_JP_LOCAL_TARGET_ACCEPTANCE_ONLY",
      "port_conclusion_eligible": false,
      "finding_scope": "SCP_JP_TARGET_ACCEPTANCE"
    },
