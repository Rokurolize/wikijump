<strong><span style="color: var(--c-keyword)"><span style="white-space: pre-wrap;">[[/div]]</span></span></strong></p>
<p><strong><span style="color: var(--c-keyword)">[[div</span></strong> <span style="color: var(--c-builtin)">class</span><span style="color: var(--c-operator)">=</span><span style="color: var(--c-string)">&quot;inkblot-info&quot;</span><strong><span style="color: var(--c-keyword)">]]</span></strong><br />
