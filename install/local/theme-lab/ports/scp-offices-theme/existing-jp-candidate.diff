+[[module CSS]]
+/* SCP-JP interaction adaptation: reveal Sigma's collapsed query input while the search control is hovered or keyboard-focused. */
+@media (min-width: 768px) {
+  #search-top-box-form:hover #search-top-box-input,
+  #search-top-box-form:focus-within #search-top-box-input {
+    display: inline-block !important;
+  }
+}
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive acceptance: scp-offices-theme account and navigation behavior */
+
+/* Keep SCP Offices navigation proportions while allowing long localized labels to wrap. */
+#side-bar .side-block a, #side-bar .collapsible-block-link, #side-bar .collapsible-block-unfolded-link { display: block; max-width: 100% !important; height: auto !important; white-space: normal !important; overflow-wrap: anywhere !important; line-height: 1.35 !important; box-sizing: border-box !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual follow-up: scp-offices-theme */
+
+/* The pale office menu needs its theme's dark ink on the collapsed submenu; localized labels can wrap without clipping. */
+#side-bar .collapsible-block-link, #side-bar .collapsible-block-unfolded-link { color: #23443b !important; white-space: normal !important; overflow-wrap: anywhere !important; line-height: 1.4 !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual follow-up v2: scp-offices-theme */
+
+/* The pale office menu needs its theme's dark ink on the collapsed submenu; localized labels can wrap without clipping. */
+#side-bar .collapsible-block-link, #side-bar .collapsible-block-unfolded-link { color: #23443b !important; white-space: normal !important; overflow-wrap: anywhere !important; line-height: 1.4 !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance evidence fix v1: scp-offices-theme */
+
+/* Office-theme submenu labels need the same dark ink as the pale gray-green panel behind them. */
+#top-bar .top-bar ul, #top-bar .top-bar ul a { color: #233b34 !important; background-color: #e8ece9 !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance evidence fix v2: scp-offices-theme */
+
+/* Keep the dropdown paper-gray treatment while assigning a dark green-gray foreground with readable contrast. */
+#top-bar .top-bar ul, #top-bar .top-bar ul a { color: #233b34 !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance mobile header refinement v5: scp-offices-theme */
+
+/* Fit the Japanese credit-view return affordance inside the existing SCP Offices card without changing its office-panel colors. */
+@media (max-width: 600px) { #u-credit-otherwise .modalbox > a[href="#u-credit-view"], #u-credit-otherwise a[href="#u-credit-view"] { display: inline-block !important; min-width: 0 !important; max-width: 100% !important; white-space: normal !important; overflow-wrap: anywhere !important; line-height: 1.3 !important; padding: .4rem .55rem !important; box-sizing: border-box !important; } #u-credit-view .modalbox-title, #u-credit-view .credit a, #u-credit-otherwise .modalbox-title, #u-credit-otherwise .modalbox a { color: #304b40 !important; } }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance image review repair v41: scp-offices-theme */
+/* Direct Files and policy-surface image review: the theme's pale mint foreground disappears on its cream/pale-gray panels. Keep the office palette and panel fills, but use its established deep green ink for links on these light reading/control surfaces. */
+#page-content a, #page-content a:visited, #interwiki a, #side-bar a, #action-area .file-attribute, #action-area .file-attribute a, #action-area .file-name, #action-area .file-name a, #page-options-bottom a, #page-options-bottom-2 a { color: #23443b !important; -webkit-text-fill-color: #23443b !important; }
+#page-content a, #interwiki a, #side-bar a, #action-area .file-name a { text-decoration: underline !important; text-underline-offset: .12em; }
+[[/module]]
