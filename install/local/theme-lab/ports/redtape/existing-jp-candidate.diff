+[[module CSS]]
+/* SCP-JP interaction adaptation: reveal Sigma's collapsed query input while the search control is hovered or keyboard-focused. */
+@media (min-width: 768px) {
+  #search-top-box-form:hover #search-top-box-input,
+  #search-top-box-form:focus-within #search-top-box-input {
+    display: inline-block !important;
+  }
+}
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive acceptance: redtape error dialog text contrast */
+
+/* The source theme intentionally uses a white Wikidot error pane. Its bright theme accent is also used for dark-shell text and fails contrast on that white pane. */
+#odialog-container .owindow.error, #odialog-container .owindow.error #modal-title, #odialog-container .owindow.error .modal-body, #odialog-container .owindow.error .modal-message-extra { color: #24151a !important; }
+#odialog-container .owindow.error .button-close-message { color: #fff !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual follow-up: redtape */
+
+/* SCP-JP navigation contrast: the expanded red tape submenu needs light text over the theme's red panel. */
+#side-bar .collapsible-block-unfolded, #side-bar .collapsible-block-unfolded a, #side-bar .collapsible-block-unfolded-link { color: #fff0e8 !important; }
+#side-bar .collapsible-block-unfolded a:hover, #side-bar .collapsible-block-unfolded-link:hover { color: #fff !important; background-color: #651014 !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual follow-up v2: redtape */
+
+/* SCP-JP navigation contrast: the expanded red tape submenu needs light text over the theme's red panel. */
+#side-bar .collapsible-block-unfolded, #side-bar .collapsible-block-unfolded a, #side-bar .collapsible-block-unfolded-link { color: #fff0e8 !important; }
+#side-bar .collapsible-block-unfolded a:hover, #side-bar .collapsible-block-unfolded-link:hover { color: #fff !important; background-color: #651014 !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance image review repair v2: redtape */
+
+/* The reviewed 390px other-license modal squeezed its Japanese back link into a vertical label. Preserve the red-tape button palette and reserve one readable line for the control. */
+@media (max-width: 600px) { #u-credit-otherwise .modalbox a[href="#u-credit-view"] { display: inline-flex !important; align-items: center !important; justify-content: center !important; flex: 0 0 auto !important; width: auto !important; min-width: 4rem !important; max-width: 100% !important; padding: .35rem .5rem !important; white-space: nowrap !important; word-break: keep-all !important; line-height: 1.25 !important; box-sizing: border-box !important; } }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance mobile header refinement v5: redtape */
+
+/* Keep the localized credit return label on one usable control at phone widths while retaining Redtape's red treatment. */
+@media (max-width: 600px) { #u-credit-otherwise .modalbox > a[href="#u-credit-view"], #u-credit-otherwise a[href="#u-credit-view"] { display: inline-block !important; min-width: 0 !important; max-width: 100% !important; white-space: normal !important; overflow-wrap: anywhere !important; line-height: 1.3 !important; padding: .4rem .55rem !important; box-sizing: border-box !important; } }
+[[/module]]
