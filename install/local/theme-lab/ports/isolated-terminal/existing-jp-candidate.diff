+[[module CSS]]
+/* SCP-JP Wikidot Isolated Terminal narrow login: wrap account links inside the masthead without changing their type scale. */
+@media(max-width:359px){#login-status{max-width:calc(100% - 2rem);white-space:normal;margin-left:0;}}
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP Wikidot Isolated Terminal native History: retain form and revision columns inside horizontal scrollers. */
+@media(max-width:767px){#revision-list,#history-form-1 .form{max-width:100%;overflow-x:auto;}#history-form-1 .form{display:block;}}
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP Wikidot Isolated Terminal narrow tables: preserve their columns in an intrinsic-width horizontal scroller. */
+@media(max-width:359px){#page-content table.wiki-content-table{display:block;max-width:100%;overflow-x:auto;width:max-content;}}
+[[/module]]
