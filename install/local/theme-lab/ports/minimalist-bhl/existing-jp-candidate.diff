+#side-bar .close-menu { color: rgb(var(--swatch-menutxt-light-color)) !important; }
+
+/* Keep the crimson interaction buttons while using the theme's light menu-text token for their labels. */
+#action-area .revision-diff-controls button { color: rgb(var(--swatch-menutxt-light-color)) !important; }
+
+
+
