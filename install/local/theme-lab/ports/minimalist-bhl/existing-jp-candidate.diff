+[[module CSS]]
+/* SCP-JP interactive acceptance: minimalist-bhl account and navigation behavior */
+
+/* Keep BHL sidebar navigation labels readable on the selected crimson menu panel. */
+#side-bar .side-block { color: rgb(var(--swatch-menutxt-light-color)) !important; }
+#side-bar .side-block a { color: rgb(var(--swatch-menutxt-light-color)) !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive acceptance: minimalist-bhl sidebar text contrast */
