+#u-credit-view .modalbox .credit a, #u-credit-otherwise .modalbox .credit a { position: relative !important; z-index: 3 !important; display: inline-block !important; padding: .1em .25em !important; color: #24151a !important; background: #fff !important; text-decoration: underline !important; }
