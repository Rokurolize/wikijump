+[[module CSS]]
+/* SCP-JP interactive visual follow-up: minimalist-bhl */
+
+/* Preserve Minimalist BHL's crimson tabs while separating their labels from the red fill and keeping nested menu text inside its panel. */
+#top-bar .top-bar a, #top-bar .top-bar a:visited { color: #fff0e8 !important; }
