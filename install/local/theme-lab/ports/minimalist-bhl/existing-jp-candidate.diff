+#side-bar .close-menu { color: rgb(var(--swatch-menutxt-light-color)) !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive acceptance: minimalist-bhl history control contrast */
+
+/* Keep BHL sidebar navigation text and its close control readable on the selected crimson panel. */
