+[[module CSS]]
+/* SCP-JP Wikidot navigation correction: turbo-vision rightmost submenu anchors. */
+@media (max-width: 767px) {
+  #top-bar .mobile-top-bar > ul > li:nth-last-child(2) > ul { left: auto; right: 0; }
+}
+@media (min-width: 360px) and (max-width: 767px) {
+  #top-bar .mobile-top-bar > ul > li:last-child > ul { left: auto; right: 0; }
+}
+/* SCP-JP Wikidot invisible masthead bound: Turbo Vision. */
+@media (max-width: 365px) {
+  div#header h1 { max-width: calc(100% - 55px); }
+}
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP Wikidot Turbo Vision desktop top-bar bound: keep its source-width row within the viewport while preserving the right inset. */
+@media (min-width: 768px) {
+  #top-bar { left: 0; right: 16px; width: calc(100% - 16px); }
+}
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP Wikidot narrow image-block correction: include the native right margin and border in its available width. */
+@media (max-width: 479px) {
+  .scp-image-block.block-right { max-width: calc(100% - 2em - 2px) !important; }
+}
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP Wikidot Turbo Vision mobile top-bar bound: preserve the right inset without negative left positioning. */
+@media (max-width: 767px) {
+  #top-bar { left: 0; right: 16px; width: calc(100% - 16px); }
+}
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP Wikidot native history list: preserve the seven columns inside their own horizontal scroller. */
+@media(max-width:767px){#revision-list {max-width:100%;overflow-x:auto;}}
+[[/module]]
+
