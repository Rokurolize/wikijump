+
+[[module CSS]]
+/* SCP-JP interaction adaptation: reveal Sigma's collapsed query input while the search control is hovered or keyboard-focused. */
+@media (min-width: 768px) {
+  #search-top-box-form:hover #search-top-box-input,
+  #search-top-box-form:focus-within #search-top-box-input {
+    display: inline-block !important;
+  }
+}
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive acceptance: aesthetic-theme account and navigation behavior */
+
+/* The narrow Aesthetic submenu keeps its purple panel and uses a pale rose foreground with readable separation. */
+@media (max-width: 400px) { #side-bar .collapsible-block-unfolded, #side-bar .collapsible-block-unfolded a { color: #fff0fa !important; } }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual follow-up v2: aesthetic-theme */
+
+/* Keep the Aesthetic return link horizontal and reachable by scrolling when its translated modal content exceeds the phone viewport. */
+@media (max-width: 600px) { #u-credit-otherwise .modalcontainer { top: 1rem !important; bottom: 1rem !important; height: auto !important; max-height: calc(100dvh - 2rem) !important; } #u-credit-otherwise .modalbox { max-height: calc(100dvh - 2rem) !important; overflow-y: auto !important; } #u-credit-otherwise .modalbox a[href="#u-credit-view"] { display: inline-block !important; min-width: 3rem !important; white-space: nowrap !important; } }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance image review repair v13: aesthetic-theme */
+/* Image-reviewed mobile contrast repair: the generated wordmark fill used Aesthetic's very dark gradient stops on its saturated magenta header, making the theme name hard to read. Keep the magenta/cyan identity and emblem while giving only the wordmark a pale cyan fill and dark outline. */
+@media (max-width: 767px) { #header h1 a::after { color: #c8ffff !important; -webkit-text-fill-color: #c8ffff !important; background: none !important; -webkit-background-clip: border-box !important; -webkit-text-stroke: .1rem #19002f !important; } }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance image review repair v14: aesthetic-theme */
+/* Follow-up image review: the upstream BHL title uses two stacked pseudo-elements; recoloring only ::after left the dark ::before glyph fill visible on the magenta masthead. Apply the same high-contrast fill to both layers while retaining a dark outline and the original emblem/background. */
+@media (max-width: 767px) { #header h1 a::before, #header h1 a::after { color: #c8ffff !important; -webkit-text-fill-color: #c8ffff !important; background: none !important; -webkit-background-clip: border-box !important; -webkit-text-stroke: .1rem #19002f !important; } }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance image review repair v24: aesthetic-theme */
+
+/* The lime sidebar highlight is a deliberate theme accent, but its pink submenu label is hard to read. Use the existing deep-plum ink on this control only. */
+#side-bar .collapsible-block-link, #side-bar .collapsible-block-unfolded-link .collapsible-block-link { color: #160c2d !important; -webkit-text-fill-color: #160c2d !important; text-shadow: none !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance image review repair v29: aesthetic-theme */
+
+/* Image review found the expanded article disclosure retained aqua ink on Aesthetic's fluorescent lime panel. Keep the neon surface and use the established deep-plum ink only inside the open content; links stay underlined. */
+#page-content .collapsible-block-unfolded .collapsible-block-content, #page-content .collapsible-block-unfolded .collapsible-block-content * { color: #160c2d !important; -webkit-text-fill-color: #160c2d !important; text-shadow: none !important; }
+#page-content .collapsible-block-unfolded .collapsible-block-content a { text-decoration: underline !important; text-underline-offset: .14em; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance image review repair v30: aesthetic-theme */
+
+/* Follow-up image review found the fluorescent yellow surface belongs to the TOC links, while the opened disclosure body uses Aesthetic's dark panel. Restore the light body ink and darken only links on the yellow TOC surface. */
+#page-content .collapsible-block-unfolded .collapsible-block-content, #page-content .collapsible-block-unfolded .collapsible-block-content * { color: #d9e9fb !important; -webkit-text-fill-color: #d9e9fb !important; text-shadow: none !important; }
+#page-content #toc-list a { color: #160c2d !important; -webkit-text-fill-color: #160c2d !important; text-shadow: none !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance image review repair v33: aesthetic-theme */
+
+/* The mobile theme header is a higher stacking context than SCP-JP's credit layer, so its hamburger crossed the fader and hid the otherwise-modal title. Drop only the header stack below the visible credit dialog while a credit hash is active. */
+body:has(#u-credit-view:target) #header, body:has(#u-credit-otherwise:target) #header { z-index: 9 !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance image review repair v34: aesthetic-theme */
+
+/* V33 lowering z-index alone did not form a stacking context because the theme leaves #header unpositioned. During either SCP-JP credit hash, isolate the in-flow header below the shared modal/fader so its high-z hamburger cannot cross the overlay. */
+body:has(#u-credit-view:target) #header, body:has(#u-credit-otherwise:target) #header { position: relative !important; isolation: isolate !important; z-index: 9 !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance image review repair v35: aesthetic-theme */
+
+/* At 320px the otherwise-license modal's one-rem container inset left an undimmed strip of the page above the fader. Extend the real hash-target overlay to the viewport edge while keeping the modal's own bounded scroll area. */
+@media (max-width: 600px) { #u-credit-otherwise:target .modalcontainer { top: 0 !important; bottom: 0 !important; height: 100dvh !important; max-height: 100dvh !important; } }
+[[/module]]
