+[[module CSS]]
+/* SCP-JP interaction adaptation: reveal Sigma's collapsed query input while the search control is hovered or keyboard-focused. */
+@media (min-width: 768px) {
+  #search-top-box-form:hover #search-top-box-input,
+  #search-top-box-form:focus-within #search-top-box-input {
+    display: inline-block !important;
+  }
+}
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual follow-up v2: hansarp */
+
+/* The moving orange Hansarp credit stripe crosses the license link; lift the link on a small opaque label without removing the stripe. */
+#u-credit-view .modalbox .credit a, #u-credit-otherwise .modalbox .credit a { position: relative !important; z-index: 3 !important; display: inline-block !important; padding: .1em .25em !important; color: #15232b !important; background: #fff !important; text-decoration: underline !important; }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP interactive visual acceptance image review repair v35: hansarp */
+
+/* The 320px credit.otherwise back label had one Japanese character per line. Keep the paired credit/back controls on one reachable row. */
+@media (max-width: 400px) { #u-credit-otherwise .modalbox .credit-back { display: flex !important; flex-wrap: nowrap !important; justify-content: center !important; align-items: center !important; gap: .35rem !important; } #u-credit-otherwise .modalbox .credit-back a[href="#u-credit-view"] { display: inline-flex !important; width: auto !important; min-width: 3rem !important; white-space: nowrap !important; word-break: keep-all !important; overflow-wrap: normal !important; } }
+[[/module]]
+
+[[module CSS]]
+/* SCP-JP navigation adaptation: constrain submenu item min-content sizing as well as the menu box so long Japanese labels reflow instead of extending past the viewport. */
+#top-bar .top-bar ul li ul, #top-bar .mobile-top-bar ul li ul { left: auto !important; right: 2rem !important; width: min(22rem, calc(100vw - 1rem)) !important; min-width: 0 !important; max-width: calc(100vw - 1rem) !important; box-sizing: border-box !important; }
+#top-bar .top-bar ul li ul li, #top-bar .mobile-top-bar ul li ul li { width: 100% !important; min-width: 0 !important; max-width: 100% !important; box-sizing: border-box !important; }
+#top-bar .top-bar ul li ul li a, #top-bar .mobile-top-bar ul li ul li a { display: block !important; width: 100% !important; min-width: 0 !important; max-width: 100% !important; white-space: normal !important; overflow-wrap: anywhere !important; box-sizing: border-box !important; }
+@media (max-width: 767px) { #top-bar .mobile-top-bar ul li ul { width: auto !important; min-width: min(12rem, calc(100vw - 1rem)) !important; } }
+[[/module]]
