{
  "schema": "wikijump.listpages_title_variable_fixture_plan.v1",
  "site": "sandbox-for-codex",
  "observation_route": "authenticated saved pages followed by an anonymous full-page GET",
  "mutates_sandbox": true,
  "cleanup_required": true,
  "target_source": "target",
  "holder_template": "TITLE=%%title%%\nLINKED=%%title_linked%%",
  "cases": [
    {
      "case_id": "listpages-title-plain",
      "title": "Plain title"
    },
    {
      "case_id": "listpages-title-html",
      "title": "<em>HTML</em> & \"quotes\" and apostrophe's"
    },
    {
      "case_id": "listpages-title-div",
      "title": "[[div class=\"owned\"]]DIV[[/div]]"
    },
    {
      "case_id": "listpages-title-module",
      "title": "[[module css]] .owned{display:none} [[/module]]"
    },
    {
      "case_id": "listpages-title-parser-function",
      "title": "[[#if 1|YES|NO]]"
    },
    {
      "case_id": "listpages-title-links",
      "title": "[http://example.com LABEL] [[[run-owned:missing|TRIPLE]]]"
    },
    {
      "case_id": "listpages-title-dots",
      "title": "x...x x....x x. . .x"
    },
    {
      "case_id": "listpages-title-mixed",
      "title": "A[[span class=\"x\"]]B[[/span]]C <b>D</b> ..."
    },
    {
      "case_id": "listpages-title-formatting",
      "title": "**BOLD** //ITALIC// __UNDER__ --STRIKE--"
    },
    {
      "case_id": "listpages-title-inline-combined",
      "title": "##red|COLOR## ^^SUP^^ ,,SUB,, {{CODE}} @@ESCAPED@@"
    },
    {
      "case_id": "listpages-title-block-markers",
      "title": "+ HEADING * LIST ||~ TABLE ||"
    },
    {
      "case_id": "listpages-title-typography",
      "title": "``DOUBLE'' `SINGLE' <<ANGLE>> 10 000 5 kg"
    },
    {
      "case_id": "listpages-title-brackets",
      "title": "[single] [[double]] [[[triple]]] \\[escaped\\]"
    },
    {
      "case_id": "listpages-title-entities",
      "title": "&amp; &lt;tag&gt; &#91;bracket&#93; <script>X</script>"
    },
    {
      "case_id": "listpages-title-color",
      "title": "##red|COLOR##"
    },
    {
      "case_id": "listpages-title-superscript",
      "title": "^^SUP^^"
    },
    {
      "case_id": "listpages-title-subscript",
      "title": ",,SUB,,"
    },
    {
      "case_id": "listpages-title-code",
      "title": "{{CODE}}"
    },
    {
      "case_id": "listpages-title-escaped",
      "title": "@@ESCAPED@@"
    },
    {
      "case_id": "listpages-title-color-and-formatting",
      "title": "**B** ##red|C##"
    },
    {
      "case_id": "listpages-title-unclosed-color",
      "title": "##red|OPEN"
    },
    {
      "case_id": "listpages-title-unclosed-superscript",
      "title": "^^OPEN"
    },
    {
      "case_id": "listpages-title-escaped-brackets",
      "title": "@@[[div]]X[[/div]]@@"
    },
    {
      "case_id": "listpages-title-unclosed-escaped",
      "title": "CHILD @@UNCLOSED"
    },
    {
      "case_id": "listpages-parent-title-context",
      "target_title": "CHILD @@UNCLOSED",
      "parent_title": "[[div]]**PARENT**... @@ESCAPED@@[[/div]]",
      "target_parent": "the run-owned parent page",
      "holder_template": "TITLE=%%title%%\nTITLE_LINKED=%%title_linked%%\nPARENT=%%parent_title%%\nPARENT_LINKED=%%parent_title_linked%%"
    }
  ]
}
