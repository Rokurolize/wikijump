    },
    {
      "surface_id": "xmlrpc-protocol:resource-boundary:node-budget",
      "kind": "resource-boundary",
      "contract": "All request parameters share one 10000-value structural node budget.",
      "source_ids": ["framerail-protocol", "framerail-api-tests"]
    },
    {
      "surface_id": "xmlrpc-protocol:resource-boundary:filter-count",
      "kind": "resource-boundary",
      "contract": "Generic page and category filter arrays are capped at 100, while tag page filters and batch get arrays are capped at 10 where defined.",
