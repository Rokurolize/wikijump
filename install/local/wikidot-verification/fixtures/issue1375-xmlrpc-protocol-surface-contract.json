    },
    {
      "surface_id": "xmlrpc-protocol:fault-boundary:http",
      "kind": "fault-boundary",
      "contract": "Authentication, method, request-size, and file-size failures may carry HTTP 401, 405, or 413 while retaining an XML-RPC fault body.",
      "source_ids": ["framerail-handler", "framerail-protocol", "framerail-api-tests", "framerail-size-tests"]
    },
    {
      "surface_id": "xmlrpc-protocol:resource-boundary:body-bytes",
      "kind": "resource-boundary",
      "contract": "The request body ceiling is 67108864 bytes and is enforced against declared and streamed bytes.",
