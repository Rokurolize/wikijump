{
  "schema": "wikijump.wikidot_membership_password_cases.v1",
  "target_surface_ids": [
    "open43-audit-case:A1033_PASSWORD_SUBMISSION",
    "catalog-feature:module-membershipbypassword"
  ],
  "required_actor_labels": [
    "setup-admin",
    "nonmember-one",
    "nonmember-two",
    "anonymous",
    "current-member-control"
  ],
  "maximum_wrong_submissions_per_actor": 3,
  "required_preflight": [
    "explicitly-authorized-disposable-site",
    "exact-reversible-password-membership-settings-baseline",
    "public-settings-mutation-and-restoration-actions",
    "two-disposable-registered-nonmembers",
    "public-member-list-verification",
    "public-membership-removal-and-verification",
    "safe-nonbrowser-membership-password-form-and-submission",
    "run-owned-holder-page-cleanup"
  ],
  "promotable_rules": [
    {
      "rule_id": "password-transition",
      "positive_case_ids": [
        "nonmember-one-correct-transition",
        "nonmember-two-correct-transition"
      ],
      "negative_case_ids": [
        "nonmember-one-wrong-denial",
        "nonmember-two-wrong-denial"
      ]
    },
    {
      "rule_id": "post-success-retry-idempotence",
      "positive_case_ids": [
        "nonmember-one-correct-retry",
        "nonmember-two-correct-retry"
      ],
      "negative_case_ids": [
        "no-duplicate-public-membership-rows",
        "neither-actor-remains-member-after-cleanup"
      ]
    }
  ],
  "blocked_contract": {
    "promoted_rules_must_be_empty": true,
    "membership_mutations_performed_must_be_zero_without_complete_preflight": true,
    "password_setting_mutations_performed_must_be_zero_without_complete_preflight": true,
    "record_raw_password_material": false,
    "record_account_identifiers": false
  }
}
