{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikijump.local/schemas/sandbox-oracle-fixture-registry-v1.schema.json",
  "title": "Wikijump sandbox oracle fixture registry",
  "type": "object",
  "required": ["schema", "fixtures"],
  "properties": {
    "schema": {
      "const": "wikijump_local_lab.sandbox_oracle_fixture_registry.v1"
    },
    "status": {
      "enum": ["draft", "sealed"]
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "fixtures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixture"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "domSignature": {
      "type": "object",
      "required": ["tags", "classes", "attrs", "id_count", "comment_count"],
      "properties": {
        "tags": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "classes": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "attrs": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "id_count": {"type": "integer", "minimum": 0},
        "comment_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "required": [
        "fixture_id",
        "construct_family",
        "guards",
        "owner",
        "assertion_class",
        "provenance"
      ],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "construct_family": {"type": "string", "minLength": 1},
        "guards": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "owner": {"enum": ["FTML", "Framerail/Deepwell"]},
        "assertion_class": {"enum": ["match-live", "match-frozen-preserved"]},
        "theme_family": {"type": ["string", "null"]},
        "provenance": {
          "type": "object",
          "required": ["datestamp", "content_sha256"],
          "properties": {
            "datestamp": {"type": "string", "pattern": "^sandbox-oracle-[0-9]{8}$"},
            "content_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "expected_preserved": {
          "type": "object",
          "required": ["dom_signature"],
          "properties": {
            "dom_signature": {"$ref": "#/$defs/domSignature"},
            "dom_signatures": {"type": "array", "items": {"type": "string"}},
            "attribute_signatures": {"type": "array", "items": {"type": "object"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"assertion_class": {"const": "match-frozen-preserved"}}},
          "then": {"required": ["expected_preserved"]}
        },
        {
          "if": {"properties": {"construct_family": {"pattern": "^(ListPages|listpages|CountPages|countpages|unknown[- ]?modules?|conditional[- ]?blocks?)$"}}},
          "then": {"properties": {"assertion_class": {"const": "match-frozen-preserved"}}}
        }
      ]
    }
  }
}
