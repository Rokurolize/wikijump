# .sh files need to have UNIX line endings
# Even on Windows, otherwise this will break Docker builds
*.sh eol=lf

# Preserve byte-for-byte anonymous Wikidot captures, including original whitespace.
install/local/wikidot-verification/fixtures/listpages-late-evidence/html-preview-context/** -whitespace

# Theme Lab source-authority snapshots preserve exact public Wikidot bytes.
install/local/theme-lab/ports/quand-le-soleil-se-couche/upstream-*.wikidot.txt -whitespace
install/local/theme-lab/ports/quand-le-soleil-se-couche/current-jp-hub.wikidot.txt -whitespace

# Browser-captured Wikidot DOM artifacts preserve their source whitespace.
install/local/theme-lab/evidence/**/*.dom.html -whitespace

# Immutable Theme Lab audit inputs and public replay responses retain exact bytes.
install/local/theme-lab/ports/**/maintenance/historical-* -whitespace
install/local/theme-lab/ports/authority-evidence/replay/objects/** -whitespace
install/local/theme-lab/ports/authority-evidence/sigma-preview/*.wikidot.txt -whitespace
install/local/theme-lab/ports/authority-evidence/sigma-preview/preview.html -whitespace
install/local/theme-lab/ports/dear-dictator/upstream-ko.css -whitespace
install/local/theme-lab/ports/*/candidate-input.css -whitespace
install/local/theme-lab/ports/*/maintenance/authority-base.wikidot.txt -whitespace
