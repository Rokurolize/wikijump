[[div class="tmp-pagesbytag"]]
[[module ListPages tags="@URL" perPage="250" separate="yes" wrapper="no" category="*"]]
%%title_linked%%
[[/module]]
[[/div]]

[[module TagCloud limit="10000" target="system:page-tags"]]

[[module CSS]]
#page-title {
    display: none;
}

#tagged-pages-list, .tmp-pagesbytag {
    margin-bottom: 2.25rem;
    column-width: 12rem;
    column-gap: 1.25rem;
    column-rule: 1px solid #888;
    position: relative;
}

.pages-list-item, .tmp-pagesbytag .list-pages-item {
    margin-bottom: 0.675em;
    line-height: 1.125;
    overflow-wrap: break-word;
}

.tmp-pagesbytag .pager {
    position: absolute;
    width: 100%;
    left: 0;
    bottom: -2.25rem;
}

.tmp-pagesbytag .list-pages-item p {
    margin: 0;
}

.pages-tag-cloud-box {
    margin-top: -0.125rem;
    display: flex;
    flex-wrap: wrap;
    grid-gap: 0.185rem;
    align-items: center;
    justify-content: space-between;
}
[[/module]]