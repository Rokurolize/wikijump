[[module CSS]]
iframe.scpnet-interwiki-frame { height: 0; }

/* Forcibly change name of AHT banned user. */
a[href*="user:info/adminbright"] {
  font-size: 0;
}
 
a[href*="user:info/adminbright"]::before {
    content: 'TheDuckMan';
    font-size: .95rem;
}
 
a[href*="user:info/adminbright"]:nth-child(1) img {
  display: none
}
 
a[href*="user:info/adminbright"]:nth-child(1)::before {
  content: "";
  width: 16px;
  height: 16px;
  background-image: url(https://05command.wdfiles.com/local--files/theme%3Asite/default_avatar.png), url(https://05command.wdfiles.com/local--files/theme%3Asite/karmabar.png);
  display: inline-block;
  background-size: contain;
  vertical-align: -0.3em;
  padding: 1px 9px 1px 8px;
  background-repeat: no-repeat;
  background-position-x: 8px, 0;
}
[[/module]]

