### Sheaf Spellchecking

spellcheck-word =
  .misspelled = Słowo z błędem pisowni: „{ $slice }”
  .forbidden = Słowo „{ $slice }” jest zabronione.
  .warned = Słowo „{ $slice }” jest prawdopodobnie niezamierzone.

spellcheck-add-word = Dodaj „{ $slice }” do słownika
  .tooltip = Dodaj słowo „{ $slice }” do lokalnego słownika

spellcheck-accept =
  Zastąp słowo „{ $slice }” słowem „{ $suggestion }”

spellcheck-source =
  spellchecker(word: { $slice }) [{ $from }, { $to }]
