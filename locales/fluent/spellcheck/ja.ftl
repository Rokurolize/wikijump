### Sheaf Spellchecking

spellcheck-word =
  .misspelled = スペルミスの単語: '{ $slice }'
  .forbidden = 単語 '{ $slice }' は使用禁止です。
  .warned = 単語 '{ $slice }' は意図したものではない可能性があります。

spellcheck-add-word = '{ $slice }' を辞書に追加
  .tooltip = 単語 '{ $slice }' をローカル辞書に追加

spellcheck-accept =
  単語 '{ $slice }' を '{ $suggestion }' に置き換え

spellcheck-source =
  スペルチェッカー(単語: { $slice }) [{ $from }, { $to }]
