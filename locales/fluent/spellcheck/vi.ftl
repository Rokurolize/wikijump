### Sheaf Spellchecking

spellcheck-word =
  .misspelled = Từ sai chính tả: '{ $slice }'
  .forbidden = Từ '{ $slice }' bị cấm.
  .warned = Từ '{ $slice }' có lẽ không phải là từ bạn muốn dùng.

spellcheck-add-word = Thêm '{ $slice }' vào từ điển
  .tooltip = Thêm từ '{ $slice }' vào từ điển cục bộ của bạn

spellcheck-accept =
  Thay từ '{ $slice }' bằng '{ $suggestion }'

spellcheck-source =
  spellchecker(word: { $slice }) [{ $from }, { $to }]
