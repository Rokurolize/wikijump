### Emails

emails-subscribed = Bạn nhận được email này vì bạn đã đăng ký nhận email từ { -service-name }.
emails-unsubscribe = Hủy đăng ký nhận email
  .text = Nếu bạn muốn hủy đăng ký nhận email, hãy nhấp vào liên kết bên dưới.
  .copy = Nếu bạn không nhấp được nút '{ $action }', hãy sao chép và dán URL sau vào trình duyệt của bạn:

emails-verify-email =
  .subject = Xác minh địa chỉ email
  .greeting = Xác minh địa chỉ email của bạn
  .intro = Vui lòng xác minh địa chỉ email của bạn bằng cách nhấp vào nút bên dưới.
  .action = Xác minh địa chỉ email
  .outro = Nếu bạn không tạo tài khoản, bạn không cần thực hiện thêm hành động nào.

emails-reset-password =
  .subject = Đã yêu cầu đặt lại mật khẩu
  .greeting = Đặt lại mật khẩu của bạn
  .intro =
    Bạn nhận được email này vì chúng tôi đã nhận được yêu cầu đặt lại
    mật khẩu cho tài khoản của bạn. Nhấp vào nút bên dưới để đặt lại mật khẩu.
  .action = Đặt lại mật khẩu
  .expires = Liên kết đặt lại mật khẩu này sẽ hết hạn sau { $count ->
    [1] 1 phút.
    *[other] { $count } phút.
  }
  .outro = Nếu bạn không yêu cầu đặt lại mật khẩu, bạn không cần thực hiện thêm hành động nào.

emails-delete-account =
  .subject = Xác nhận xóa tài khoản
  .greeting = Xác nhận xóa tài khoản
  .intro = Vui lòng xác nhận rằng bạn muốn xóa tài khoản của mình bằng cách nhấp vào nút bên dưới.
  .action = Xóa tài khoản của tôi
  .outro = Nếu bạn không yêu cầu xóa tài khoản, bạn không cần thực hiện thêm hành động nào.

emails-reset-grant =
  .subject = Yêu cầu đặt lại mật khẩu đã được chấp thuận
  .greeting = Yêu cầu đặt lại mật khẩu đã được chấp thuận
  .intro = Yêu cầu đặt lại mật khẩu của bạn đã được chấp thuận. Hãy tiếp tục trong trình duyệt của bạn; email này không có liên kết cần truy cập.
  .outro = Nếu bạn không yêu cầu đặt lại mật khẩu, bạn không cần thực hiện thêm hành động nào.

emails-delete-grant =
  .subject = Yêu cầu xóa tài khoản đã được chấp thuận
  .greeting = Yêu cầu xóa tài khoản đã được chấp thuận
  .intro = Yêu cầu xóa tài khoản của bạn đã được chấp thuận. Hãy tiếp tục trong trình duyệt của bạn; email này không có liên kết cần truy cập.
  .outro = Nếu bạn không yêu cầu xóa tài khoản, bạn không cần thực hiện thêm hành động nào.

emails-invitation =
  .subject = Lời mời tham gia { $site_name }
  .greeting = Xin chào, { $recipient_name }!
  .intro = { $sender_name } đã mời bạn tham gia { $site_name }.
  .action = Chấp nhận lời mời
  .outro = Nếu bạn không mong đợi lời mời này, bạn có thể bỏ qua email này.
