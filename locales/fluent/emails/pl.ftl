### Emails

emails-subscribed = Otrzymujesz tę wiadomość, ponieważ subskrybujesz { -service-name }.
emails-unsubscribe = Anuluj subskrypcję
  .text = Jeśli chcesz anulować subskrypcję, kliknij poniższy link.
  .copy = Jeśli nie możesz kliknąć przycisku „{ $action }”, skopiuj poniższy adres URL i wklej go w przeglądarce:

emails-verify-email =
  .subject = Potwierdź adres email
  .greeting = Potwierdź swój adres email
  .intro = Potwierdź swój adres email, klikając poniższy przycisk.
  .action = Potwierdź adres email
  .outro = Jeśli to konto nie zostało utworzone przez Ciebie, nie musisz nic robić.

emails-reset-password =
  .subject = Prośba o zresetowanie hasła
  .greeting = Resetowanie hasła
  .intro =
    Otrzymujesz tę wiadomość, ponieważ otrzymaliśmy prośbę o zresetowanie
    hasła do Twojego konta. Kliknij poniższy przycisk, aby zresetować hasło.
  .action = Zresetuj hasło
  .expires = Ten link do resetowania hasła wygaśnie za { $count ->
    [1] 1 minutę.
    *[other] { $count } min.
  }
  .outro = Jeśli ta prośba nie pochodzi od Ciebie, nie musisz nic robić.

emails-delete-account =
  .subject = Potwierdź usunięcie konta
  .greeting = Potwierdź usunięcie konta
  .intro = Potwierdź, że chcesz usunąć swoje konto, klikając poniższy przycisk.
  .action = Usuń moje konto
  .outro = Jeśli ta prośba nie pochodzi od Ciebie, nie musisz nic robić.

emails-reset-grant =
  .subject = Resetowanie hasła zatwierdzone
  .greeting = Resetowanie hasła zatwierdzone
  .intro = Prośba o zresetowanie hasła została zatwierdzona. Kontynuuj w przeglądarce; ta wiadomość nie zawiera linku.
  .outro = Jeśli ta prośba nie pochodzi od Ciebie, nie musisz nic robić.

emails-delete-grant =
  .subject = Usunięcie konta zatwierdzone
  .greeting = Usunięcie konta zatwierdzone
  .intro = Prośba o usunięcie konta została zatwierdzona. Kontynuuj w przeglądarce; ta wiadomość nie zawiera linku.
  .outro = Jeśli ta prośba nie pochodzi od Ciebie, nie musisz nic robić.

emails-invitation =
  .subject = Zaproszenie do witryny { $site_name }
  .greeting = Witaj, { $recipient_name }!
  .intro = { $sender_name } zaprasza Cię do witryny { $site_name }.
  .action = Przyjmij zaproszenie
  .outro = Jeśli nie spodziewasz się tego zaproszenia, możesz zignorować tę wiadomość.
