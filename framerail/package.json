{
  "name": "framerail",
  "version": "2026.3.25",
  "description": "Framerail - Wikijump frontend service",
  "repository": "https://github.com/scpwiki/wikijump/tree/develop/framerail",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.10.0"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/playwright-runner.js",
    "test:browser-support": "node tests/playwright-runner.js --config playwright.browser-support.config.ts",
    "test:unit": "node --test tests/*.test.js tests/*.test.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint . && stylelint ./src/**/*.{css,scss,svelte}",
    "lint:fix": "prettier --write . && eslint . --fix && stylelint ./src/**/*.{css,scss,svelte} --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/accept-language-parser": "^1.5.8",
    "@types/node": "^26.1.2",
    "@types/prismjs": "1.26.6",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.25",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@popperjs/core": "^2.11.8",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "accept-language-parser": "^1.5.0",
    "include-media": "^2.0.0",
    "jquery": "4.0.0",
    "jquery-ui": "1.14.2",
    "json-rpc-2.0": "^1.7.1",
    "prismjs": "1.30.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-preprocess": "^6.0.5",
    "sveltekit-superforms": "^2.30.2",
    "valibot": "^1.4.2"
  }
}
